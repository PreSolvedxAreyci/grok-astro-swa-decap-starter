---
import BaseLayout from "../../layouts/BaseLayout.astro";
import { getCollection } from "astro:content";

const products = (await getCollection("products", ({ data }) => !data.draft))
  .sort((a, b) => a.data.order - b.data.order);
---
<BaseLayout title="Products" description="Grok demo products.">
  <div class="page-header">
    <div class="container">
      <h1>Products</h1>
      <p>Sample product pages backed by Astro content collections and Decap CMS.</p>
    </div>
  </div>
  <section class="section">
    <div class="container card-grid">
      {products.map((p) => (
        <a class="card" href={`/products/${p.slug}`}>
          <span class="card-meta">{p.data.category}{p.data.sku ? ` · ${p.data.sku}` : ""}</span>
          <h3>{p.data.title}</h3>
          <p>{p.data.description}</p>
          <span class="card-link">Learn more →</span>
        </a>
      ))}
    </div>
  </section>
</BaseLayout>